# 🛡️ 医疗急诊分诊系统 - 前端生产环境配置

# API服务器配置
VITE_API_BASE_URL=https://your-domain.com/api
VITE_WS_URL=wss://your-domain.com/ws

# 应用配置
VITE_APP_TITLE=医疗急诊分诊管理系统
VITE_APP_VERSION=2.0.0
VITE_APP_ENV=production

# 🛡️ 安全配置
VITE_ENABLE_CORS=true
VITE_ENABLE_MOCK=false
VITE_ENABLE_DEVTOOLS=false

# AI功能配置
VITE_ENABLE_AI_FEATURES=true
VITE_AI_CONFIDENCE_THRESHOLD=0.8

# 实时功能配置
VITE_ENABLE_REAL_TIME=true
VITE_HEARTBEAT_INTERVAL=30000

# 🛡️ 性能配置
VITE_REQUEST_TIMEOUT=10000
VITE_RETRY_ATTEMPTS=3
VITE_CHUNK_SIZE=1024

# 🛡️ 安全配置
VITE_ENABLE_ENCRYPTION=true
VITE_TOKEN_STORAGE=sessionStorage

# 主题配置
VITE_THEME_MODE=light
VITE_PRIMARY_COLOR=#409EFF
VITE_DANGER_COLOR=#F56C6C

# 🛡️ 监控配置
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# 地图配置（如果需要）
VITE_MAP_API_KEY=your-map-api-key
VITE_ENABLE_GEOLOCATION=true

# 文件上传配置
VITE_MAX_FILE_SIZE=10485760  # 10MB
VITE_ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# 🛡️ 其他配置
VITE_DEFAULT_LANGUAGE=zh-CN
VITE_TIMEZONE=Asia/Shanghai
VITE_DATE_FORMAT=YYYY-MM-DD HH:mm:ss