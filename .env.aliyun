# ================================================
# 医疗急诊分诊系统 - 阿里云生产环境配置
# 部署前请修改所有带 "CHANGE_THIS" 的值
# ================================================

# ========== 服务器配置 ==========
# 你的阿里云服务器公网IP（部署后修改）
SERVER_IP=CHANGE_THIS_YOUR_ALIYUN_IP

# ========== 数据库配置 ==========
MYSQL_ROOT_PASSWORD=CHANGE_THIS_Strong_Root_Pwd_2024!
MYSQL_DATABASE=medical_web
MYSQL_USER=medical
MYSQL_PASSWORD=CHANGE_THIS_Strong_DB_Pwd_2024!
MYSQL_PORT=3306

# ========== Redis配置 ==========
REDIS_PASSWORD=CHANGE_THIS_Strong_Redis_Pwd_2024!
REDIS_PORT=6379

# ========== JWT安全配置 ==========
# 请使用随机生成的长字符串，至少64个字符
JWT_SECRET=CHANGE_THIS_Generate_A_Very_Long_Random_JWT_Secret_Key_At_Least_64_Characters_Long_2024

# ========== 百川AI配置 ==========
BAICHUAN_API_KEY=CHANGE_THIS_YOUR_BAICHUAN_API_KEY
BAICHUAN_API_BASE_URL=https://api.baichuan-ai.com/v1
BAICHUAN_MODEL_NAME=Baichuan2-Turbo-192k

# ========== MQTT配置 ==========
MQTT_BROKER_URL=tcp://mosquitto:1883
MQTT_CLIENT_ID=medical-cloud-server
MQTT_USERNAME=
MQTT_PASSWORD=

# ========== 向量数据库配置（可选）==========
CHROMA_DB_URL=http://localhost:8000
CHROMA_COLLECTION=medical-knowledge

# ========== Spring配置 ==========
SPRING_PROFILES_ACTIVE=prod,secure

# ========== 日志配置 ==========
LOG_LEVEL=INFO

# ========== 端口配置 ==========
BACKEND_PORT=8080
FRONTEND_PORT=80

# ========== 前端API配置 ==========
# 部署后修改为你的服务器公网IP
VITE_API_BASE_URL=http://CHANGE_THIS_YOUR_ALIYUN_IP:8080
